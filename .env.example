# Copy to .env for local development (never commit .env).
# On Hostinger, set these in hPanel › Websites › (your Node.js app) › Environment variables instead.

# --- Claude (required for the writing skills) ---
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (default: fast, good), claude-opus-5-5 (best drafts, ~2x cost), claude-haiku-5-5 (cheapest)
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: low | medium | high. Empty = the model's default.
CLAUDE_EFFORT=

# --- Database ---
# Production (Hostinger MySQL). Use 127.0.0.1, not the srvNNNN.hstgr.io host.
DB_HOST=127.0.0.1
DB_NAME=
DB_USER=
DB_PASSWORD=
# Local development: leave DB_NAME empty to use a SQLite file instead (data/studio.sqlite).
# DB_DRIVER=sqlite

# --- Sessions and first-run setup ---
# A long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Lets the first visitor create the first admin login (only works while there are no users). Remove it afterwards.
SETUP_TOKEN=

# --- Cost guard: Claude requests per person ---
ASK_PER_MINUTE=6
ASK_PER_DAY=150

PORT=3000
NODE_ENV=production
